# Vorlage für die .env des Monitoring-Stacks.
# Kopiert diese Datei nach ".env" (gleicher Ordner) und passt bei Bedarf
# die Host-Ports an, falls bei euch etwas belegt ist.

# Host-Ports (die Zahl LINKS vom ":" in der compose.yaml)
STATION_PORT=8090
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
CADVISOR_PORT=8085
NODE_EXPORTER_PORT=9100

# Grafana-Login beim allerersten Start
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

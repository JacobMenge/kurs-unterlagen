# Beispiel-Konfiguration für den Mission-Control-Stack.
# Kopiere diese Datei nach `.env` und passe ggf. die Werte an.
#
#   cp .env.example .env       (Linux/macOS/Git Bash)
#   copy .env.example .env     (Windows CMD)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Compose liest `.env` automatisch ein, wenn die Datei im selben
# Ordner wie die `compose.yaml` liegt.

# --- Datenbank ---------------------------------------------------------------
POSTGRES_USER=aurora
POSTGRES_PASSWORD=aurorapass
POSTGRES_DB=auroradb

# --- Externe Ports (auf eurem Rechner) ---------------------------------------
FRONTEND_PORT=8080
ADMINER_PORT=8081

# --- Backend-Konfiguration ---------------------------------------------------
BACKEND_PORT=3000
